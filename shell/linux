#!/usr/bin/env bash

# Unmap CTRL+s / CTRL+q
stty stop undef
stty start undef

# Add directories to PATH without duplicates
path_prepend() {
  [ -d "$1" ] && [[ ":$PATH:" != *":$1:"* ]] && PATH="$1:$PATH"
}

# rbenv gem
if [ -d "$HOME/.rbenv/shims" ]; then
  path_prepend "$HOME/.rbenv/shims"
  export RBENV_SHELL=bash
elif command -v gem >/dev/null 2>&1; then
  # system ruby gem
  if [ -e /tmp/ruby_gem_bin_dir ]; then
    ruby_gem_bin_dir="$(</tmp/ruby_gem_bin_dir)"
  else
    ruby_gem_bin_dir=$(gem env user_gemhome | tee /tmp/ruby_gem_bin_dir)
  fi
  if [ -d "$ruby_gem_bin_dir/bin" ]; then
    path_prepend "$ruby_gem_bin_dir/bin"
  fi
fi

# User binaries
path_prepend "$HOME/.local/bin"    # Local user binaries
path_prepend "$HOME/.dotfiles/bin" # Personal scripts

export PATH

alias ls='ls --color=auto'
alias up='_BUILD_DOCS=0 yay -Syu --noconfirm'
alias yaourt='yay'
alias usb3='sudo modprobe -r xhci_pci && sudo modprobe xhci-pci'

# vivid ls colors
if command -v vivid >/dev/null 2>&1; then
  if [ ! -f /tmp/ls_colors_cache ]; then
    vivid generate ayu_bold >/tmp/ls_colors_cache
  fi
  LS_COLORS="$(</tmp/ls_colors_cache)"
  export LS_COLORS
else
  eval "$(dircolors -b "$HOME"/.dir_colors)"
fi

# Yazi
if command -v yazi >/dev/null 2>&1; then
  function y() {
    local tmp
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd <"$tmp"
    [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || exit
    command rm -f -- "$tmp"
  }
fi

bupc() {
  update_gem
  update_vagrant
  update_rustup
  clean_local_packages
  up
}

update_gem() {
  if command -v gem >/dev/null 2>&1; then
    gem update --system
    gem update
    gem cleanup
  fi
  if command -v rbenv >/dev/null 2>&1; then
    rbenv rehash
  fi
}

update_rustup() {
  if command -v rustup >/dev/null 2>&1; then
    rustup update
  fi
}

update_vagrant() {
  if command -v vagrant >/dev/null 2>&1; then
    vagrant plugin update
    vagrant box update
    vagrant box prune
  fi
}

clean_go() {
  if command -v go >/dev/null 2>&1; then
    go clean -cache -modcache
  fi
}

clean_cargo() {
  if command -v cargo >/dev/null 2>&1; then
    cargo install --quiet cargo-cache
    cargo cache -a
  fi
}

clean_npm() {
  if command -v npm >/dev/null 2>&1; then
    npm cache verify >/dev/null 2>&1
  fi
  if command -v yarn >/dev/null 2>&1; then
    yarn cache clean >/dev/null 2>&1
  fi
  if command -v pnpm >/dev/null 2>&1; then
    pnpm store prune >/dev/null 2>&1
  fi
}

clean_nuget() {
  if command -v dotnet >/dev/null 2>&1; then
    dotnet nuget locals --clear all
  fi
}

clean_local_packages() {
  clean_go
  clean_cargo
  clean_npm
  clean_nuget
}

pbcopy() {
  xclip -selection clipboard
}

pbpaste() {
  xclip -selection clipboard -o
}
