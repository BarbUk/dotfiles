set -o errexit -o pipefail -o nounset

main() {
  local target agent_sockets local_socket="$HOME/.${USER}_ssh_auth_sock"
  mapfile -t agent_sockets < <(find /tmp -path "/tmp/systemd-private*" -prune -o -type s -user "$USER" -name '*agent*' -printf '%T@ %Tc %p\n' | sort -rn | awk '{print $NF}')
  if ((${#agent_sockets[@]} == 0)); then
    echo "No agent socket detected"
    exit 1
  fi

  if [[ -L "$local_socket" ]]; then
    target=$(readlink -f "$local_socket")
    if [[ "${agent_sockets[0]}" != "$target" ]]; then
      echo "Updating to use last created agent socket"
      ln -sf "${agent_sockets[0]}" "$HOME/.${USER}_ssh_auth_sock"
    else
      local counter=0 max="${#agent_sockets[@]}" item choice
      for item in "${agent_sockets[@]}"; do
        echo "${counter}: $item"
        ((++counter))
      done

      echo
      read -rp "Which socket do you want to use: " choice
      if [[ "$choice" =~ ^[0-9]$ ]] && ((choice <= max)); then
        echo "Updating agent socket with ${agent_sockets[$choice]}"
        ln -sf "${agent_sockets[$choice]}" "$HOME/.${USER}_ssh_auth_sock"
      fi
    fi
  else
    echo "Updating to use last created agent socket"
    ln -sf "${agent_sockets[0]}" "$HOME/.${USER}_ssh_auth_sock"
  fi
}

main
